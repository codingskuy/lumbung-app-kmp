-- Irisan awal tulis-lokal-dahulu: lot dan pemetaan nomor sementara. Entitas lain menyusul per tiket layar.
CREATE TABLE lot (
    uuid TEXT PRIMARY KEY NOT NULL,
    kode TEXT NOT NULL,
    petani_uuid TEXT NOT NULL,
    tanggal TEXT NOT NULL,
    komoditas TEXT NOT NULL,
    berat_kotor_g INTEGER NOT NULL,
    status TEXT NOT NULL,
    dibuat_pada_ms INTEGER NOT NULL,
    dibuat_oleh TEXT NOT NULL,
    versi INTEGER NOT NULL DEFAULT 1
);

simpanLot:
INSERT INTO lot(uuid, kode, petani_uuid, tanggal, komoditas, berat_kotor_g, status, dibuat_pada_ms, dibuat_oleh, versi)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 1);

lotByUuid:
SELECT * FROM lot WHERE uuid = ?;

lotByKode:
SELECT * FROM lot WHERE kode = ?;

ubahKodeLot:
UPDATE lot SET kode = ?, versi = versi + 1 WHERE kode = ?;

CREATE TABLE nomor_map (
    sementara TEXT PRIMARY KEY NOT NULL,
    resmi TEXT NOT NULL
);

petakan:
INSERT OR REPLACE INTO nomor_map(sementara, resmi) VALUES (?, ?);

petaSemua:
SELECT * FROM nomor_map;

CREATE TABLE meta (
    kunci TEXT PRIMARY KEY NOT NULL,
    nilai TEXT NOT NULL
);

setMeta:
INSERT OR REPLACE INTO meta(kunci, nilai) VALUES (?, ?);

getMeta:
SELECT nilai FROM meta WHERE kunci = ?;
